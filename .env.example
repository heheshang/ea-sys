# docker compose 环境变量模板（复制为 .env 后填入真实值；.env 已被 gitignore，密钥不入库）。
# 生效方式：docker compose up -d --force-recreate api
# 变量由 docker-compose.yml 读取并注入 api / notify 容器（含 SpringBoot relaxed binding 覆盖 application.yml）。

# ---- LLM 主提供方（必填，OpenAI 兼容） ----
# 服务商 API key（对应 application.yml 的 easysys.agent.llm.api-key）
EA_LLM_API_KEY=
# OpenAI 兼容 base URL（默认阿里云 Token Plan 兼容模式）
EA_LLM_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 模型 ID，形如 openai:<模型名>（默认 qwen3.7-plus；nube-api 提供方可用 deepseek-v4-flash / qwen3.8-27b 等）
EA_LLM_MODEL_ID=openai:qwen3.7-plus
# LLM 总开关：false 时走确定性规则模型（不产生 token 计量）
EA_LLM_ENABLED=true

# ---- 安全（生产环境务必替换默认值） ----
# JWT 签名密钥（32 字节以上随机串）
JWT_SECRET=ea-sys-dev-secret-key-change-me-0123456789abcdef0123456789abcdef
# 模板通道凭证加密口令
CHANNEL_ENCRYPT_PASSWORD=ea-sys-dev-channel-key

# ---- 通知服务行为（可选） ----
# mock 通知模拟投递延迟毫秒数
NOTIFY_SIMULATE_DELAY_MS=500