<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.easysys</groupId>
    <artifactId>ea-sys-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>ea-sys-agent</artifactId>
  <name>ea-sys-agent</name>
  <description>智能体编排（AgentScope Java 2.0）：分层/路由/流失预警（M4）</description>

  <dependencies>
    <dependency>
      <groupId>com.easysys</groupId>
      <artifactId>ea-sys-common</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- AgentScope Java 2.0 智能体编排基座：确定性 RuleModel 经 ReActAgent 承载主提供方逻辑 -->
    <dependency>
      <groupId>io.agentscope</groupId>
      <artifactId>agentscope-core</artifactId>
    </dependency>
    <!-- 结构化输出 schema 语义校验（框架 native 路径只解析 JSON 不做语义校验，AgentExecutor 兜底层负责硬校验） -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>2.0.0</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>